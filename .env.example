# Documentation template only. Do not use empty values as production secrets.
# Run: python3 scripts/generate_env.py
QUALITY_ENVIRONMENT=production
QUALITY_IMAGE=quality-agent:local
QUALITY_PYTHON_BASE_IMAGE=python:3.12-slim
QUALITY_POSTGRES_IMAGE=postgres:16
QUALITY_BIND_HOST=127.0.0.1
QUALITY_HTTP_PORT=18080
QUALITY_DB_PASSWORD=
QUALITY_DATABASE_URL=
QUALITY_HUMAN_JWT_SECRET=
QUALITY_MODEL_JWT_SECRET=
QUALITY_TRACE_JWT_SECRET=
QUALITY_WORKER_JWT_SECRET=
QUALITY_RECOVERY_EPOCH=
QUALITY_JWT_ISSUER=quality-openwebui
QUALITY_JWT_AUDIENCE=quality-api
QUALITY_USER_TEAMS_JSON={}
QUALITY_CURATOR_IDS_JSON=[]

# The following values belong to the EXISTING Open WebUI runtime, not the API.
# Set verified CDEP origins. Never expose signing secrets to the browser/model.
# QUALITY_API_BASE_URL=https://<quality-api-server>
# QUALITY_UI_BASE_URL=https://<quality-api-browser-origin>
# QUALITY_INSTANCE_ID=<stable-openwebui-instance-id>
# QUALITY_OUTBOX_PATH=<persistent-openwebui-private-path>/quality_outbox.sqlite3

# Enable only during isolated restore verification. Worker will refuse to run.
QUALITY_RECOVERY_MODE=false
QUALITY_DRAINING=false
